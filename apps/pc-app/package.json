{
  "name": "@qiuai/pc-app",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "QiuAI WorkOS desktop client",
  "author": "QiuAI",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:clean": "cross-env QIUAI_PC_RESET_USER_DATA=1 node scripts/dev.mjs",
    "build": "npm run build:electron && npm run build:renderer",
    "build:electron": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json",
    "build:renderer": "npm exec -- vite build",
    "start": "electron .",
    "package": "npm run build && node scripts/package.mjs && node scripts/check-runtime-dependencies.mjs --portable",
    "package:installer": "npm run build && node scripts/package-installer.mjs && node scripts/check-runtime-dependencies.mjs --installer",
    "check:runtime-dependencies": "node scripts/check-runtime-dependencies.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "node -e \"console.log('Electron lint placeholder.')\"",
    "test": "node --import tsx --test src/shared/academic-demo-config.test.ts src/shared/desktop-state.test.ts src/shared/workflow-runtime.test.ts src/shared/desktop-model-presets.test.ts src/shared/desktop-model-credentials.test.ts src/shared/desktop-role-requirements.test.ts src/shared/desktop-task-runner.test.ts src/main/artifact-store.test.ts src/main/desktop-tool.test.ts src/main/model-chat.test.ts src/main/runtime-store.test.ts src/main/storage-paths.test.ts src/main/workspace-backup.test.ts src/renderer/prompt-snippet-catalog.test.ts src/renderer/factory-preview.test.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@qiuai/api-contract": "1.0.0",
    "@qiuai/design-tokens": "1.0.0",
    "@qiuai/domain": "1.0.0",
    "@qiuai/ui": "1.0.0",
    "@types/pdf-parse": "1.1.5",
    "antd": "^5.0.0",
    "jszip": "3.10.1",
    "pdf-parse": "1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "7zip-bin": "5.2.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "39.8.10",
    "electron-builder": "24.13.3",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.qiuai.workos.pc",
    "productName": "QiuAI WorkOS",
    "directories": {
      "output": "release/installers"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QiuAI WorkOS",
      "include": "build/installer.nsh"
    }
  }
}
