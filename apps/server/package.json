{
  "name": "@qiuai/server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:sync:catalogs": "tsx prisma/seed.ts --managed-catalogs-only",
    "prisma:sync:managed-production": "tsx prisma/seed.ts --managed-production-sync",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "lint": "node -e \"console.log('Server lint placeholder.')\"",
    "test": "node --import tsx --test src/main.test.ts src/modules/billing/alipay-gateway.test.ts src/modules/desktop-sync/desktop-sync.contract.test.ts src/modules/invitation/invitation-token.test.ts src/shared/official-model-api-key-lease-cleanup.test.ts src/shared/role-template-catalog.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "6.19.3",
    "@types/pdf-parse": "1.1.5",
    "alipay-sdk": "4.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "fastify": "5.11.0",
    "pdf-parse": "1.1.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
