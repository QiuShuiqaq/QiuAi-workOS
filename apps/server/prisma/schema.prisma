generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantType {
  PERSONAL
  ENTERPRISE
  PLATFORM
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum WorkspaceType {
  PERSONAL
  ENTERPRISE
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum PlanCode {
  PERSONAL_FREE
  PERSONAL_MEMBER_MONTHLY
  PERSONAL_MEMBER_ANNUAL
  ENTERPRISE_BASIC_MONTHLY
  ENTERPRISE_BASIC_ANNUAL
  ENTERPRISE_STANDARD_MONTHLY
  ENTERPRISE_STANDARD_ANNUAL
  ENTERPRISE_PRO_MONTHLY
  ENTERPRISE_PRO_ANNUAL
  ENTERPRISE_MONTHLY
  ENTERPRISE_ANNUAL
  ENTERPRISE_CUSTOM
}

enum BillingCycle {
  FREE
  MONTHLY
  ANNUAL
  CUSTOM
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  FREE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  ALIPAY
}

enum BillingAccountStatus {
  ACTIVE
  DISABLED
}

enum BillingOrderStatus {
  PENDING
  PAID
  CLOSED
  CANCELLED
  FAILED
}

enum PaymentTransactionStatus {
  INITIATED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum SoftwareCopilotProductStatus {
  ACTIVE
  COMING_SOON
  ARCHIVED
}

enum SoftwareCopilotLicenseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SoftwareCopilotDeviceBindingStatus {
  ACTIVE
  REVOKED
}

enum RoleInstanceStatus {
  RUNNING
  TRIAL
  CONFIGURATION_REQUIRED
  PAUSED
}

enum RoleTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum RoleTemplateApplicationType {
  DIGITAL_EMPLOYEE
  DIGITAL_FACTORY
}

enum AssetDefinitionType {
  VARIABLE
  MODEL
  TOOL
  ARTIFACT_TEMPLATE
  NODE_TEMPLATE
}

enum AssetDefinitionStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum AssetDefinitionScope {
  SYSTEM
  CUSTOM
}

enum TaskStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskArtifactType {
  TEXT
  REPORT
  VIDEO
  IMAGE
  FILE
}

enum ExecutionLogLevel {
  INFO
  WARNING
  ERROR
}

enum DesktopBindingCodeStatus {
  PENDING
  REDEEMED
  EXPIRED
  CANCELLED
}

enum DesktopDeviceStatus {
  ACTIVE
  REVOKED
}

enum DesktopReleaseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DesktopIssueCategory {
  BUG
  USAGE
  FEATURE_REQUEST
  BAD_OUTPUT
  OTHER
}

enum DesktopIssueSeverity {
  NORMAL
  IMPACTING
  BLOCKING
}

enum DesktopIssueStatus {
  NEW
  VIEWED
  IN_PROGRESS
  FIXED
  WONT_FIX
  CLOSED
}

enum AiPointLedgerEntryType {
  PURCHASE
  GRANT
  RESERVE
  SETTLE
  RELEASE
  ADJUSTMENT
}

enum AiPointLedgerEntryStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum AiPointCreditBucketSourceType {
  SUBSCRIPTION_MONTHLY
  PURCHASE_PERMANENT
  ADMIN_GRANT
  REFERRAL_REWARD
  MIGRATED_BALANCE
}

enum AiPointCreditBucketStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ReferralCodeStatus {
  ACTIVE
  DISABLED
}

enum ReferralInviteStatus {
  PENDING
  PAID
  REWARDED
  REJECTED
}

enum OfficialModelRouteCapability {
  TEXT
  REASONING
  IMAGE
  VIDEO
}

enum OfficialModelRouteStatus {
  ACTIVE
  DISABLED
}

enum OfficialModelApiKeyStatus {
  ACTIVE
  DISABLED
  COOLDOWN
}

enum OfficialModelApiKeyLeaseStatus {
  ACTIVE
  RELEASED
  FAILED
  EXPIRED
}

enum DesktopDeviceAiQuotaStatus {
  ACTIVE
  DISABLED
}

enum KnowledgeBaseScope {
  ENTERPRISE
  LOCAL
}

enum KnowledgeBaseStatus {
  ACTIVE
  DISABLED
}

enum KnowledgeBaseVersionStatus {
  PROCESSING
  READY
  FAILED
  ARCHIVED
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  primaryEmail String        @unique @map("primary_email")
  phone        String?
  passwordHash String?       @map("password_hash")
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  authSessions    AuthSession[]
  createdInvitations Invitation[]   @relation("InvitationCreatedBy")
  acceptedInvitations Invitation[]  @relation("InvitationAcceptedBy")
  desktopBindingCodes DesktopBindingCode[]
  adminActionLogs AdminActionLog[] @relation("AdminActionOperator")
  referralCodes ReferralCode[] @relation("ReferralCodeOwner")
  referralInvitesSent ReferralInvite[] @relation("ReferralInviteInviter")
  referralInvitesReceived ReferralInvite[] @relation("ReferralInviteInvitee")

  @@map("accounts")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastSeenAt       DateTime? @map("last_seen_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  type      TenantType
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  workspaces    Workspace[]
  organizations Organization[]

  @@map("tenants")
}

model Workspace {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  type           WorkspaceType
  name           String
  ownerAccountId String          @map("owner_account_id") @db.Uuid
  status         WorkspaceStatus @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ownerAccount   Account           @relation("WorkspaceOwner", fields: [ownerAccountId], references: [id], onDelete: Restrict)
  organization   Organization?
  memberships    WorkspaceMember[]
  subscriptions  Subscription[]
  usageMeters    UsageMeter[]
  billingAccount BillingAccount?
  billingOrders  BillingOrder[]
  roleInstances  RoleInstance[]
  tasks          Task[]
  costRecords    CostRecord[]
  desktopRuntimeSyncs DesktopRuntimeSync[]
  desktopBindingCodes DesktopBindingCode[]
  desktopDevices DesktopDevice[]
  aiPointWallet AiPointWallet?
  aiPointCreditBuckets AiPointCreditBucket[]
  aiPointLedgerEntries AiPointLedgerEntry[]
  desktopDeviceAiQuotas DesktopDeviceAiQuota[]
  desktopIssueReports DesktopIssueReport[]
  softwareCopilotLicenses SoftwareCopilotLicense[]
  softwareCopilotOrders SoftwareCopilotOrder[]
  softwareCopilotDeviceBindings SoftwareCopilotDeviceBinding[]
  knowledgeBases KnowledgeBase[]
  invitations    Invitation[]
  referralCodes ReferralCode[] @relation("ReferralCodeWorkspace")
  referralInvitesSent ReferralInvite[] @relation("ReferralInviteInviterWorkspace")
  referralInvitesReceived ReferralInvite[] @relation("ReferralInviteInviteeWorkspace")

  @@index([tenantId])
  @@index([ownerAccountId])
  @@map("workspaces")
}

model WorkspaceMember {
  id           String              @id @default(uuid()) @db.Uuid
  workspaceId  String              @map("workspace_id") @db.Uuid
  accountId    String              @map("account_id") @db.Uuid
  departmentId String?             @map("department_id") @db.Uuid
  role         WorkspaceMemberRole @default(MEMBER)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  department       Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ownedDepartments Department[]   @relation("DepartmentOwner")
  ownedRoles       RoleInstance[] @relation("RoleInstanceOwner")

  @@unique([workspaceId, accountId])
  @@index([accountId])
  @@index([departmentId])
  @@map("workspace_members")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workspaceId String   @unique @map("workspace_id") @db.Uuid
  name        String
  industry    String?
  size        String?
  settings    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  departments Department[]

  @@index([tenantId])
  @@map("organizations")
}

model Department {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  parentDepartmentId String?  @map("parent_department_id") @db.Uuid
  name               String
  ownerMemberId      String?  @map("owner_member_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments Department[]      @relation("DepartmentHierarchy")
  ownerMember      WorkspaceMember?  @relation("DepartmentOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  members          WorkspaceMember[]
  roleInstances    RoleInstance[]
  invitations      Invitation[]

  @@index([organizationId])
  @@index([parentDepartmentId])
  @@index([ownerMemberId])
  @@map("departments")
}

model Invitation {
  id                  String              @id @default(uuid()) @db.Uuid
  workspaceId         String              @map("workspace_id") @db.Uuid
  departmentId        String?             @map("department_id") @db.Uuid
  email               String
  role                WorkspaceMemberRole @default(MEMBER)
  tokenHash           String              @unique @map("token_hash")
  status              InvitationStatus    @default(PENDING)
  expiresAt           DateTime            @map("expires_at")
  acceptedAt          DateTime?           @map("accepted_at")
  acceptedByAccountId String?             @map("accepted_by_account_id") @db.Uuid
  createdByAccountId  String?             @map("created_by_account_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department        Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  acceptedByAccount Account?    @relation("InvitationAcceptedBy", fields: [acceptedByAccountId], references: [id], onDelete: SetNull)
  createdByAccount  Account?    @relation("InvitationCreatedBy", fields: [createdByAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([departmentId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([createdByAccountId])
  @@index([acceptedByAccountId])
  @@map("invitations")
}

model DesktopBindingCode {
  id                  String                   @id @default(uuid()) @db.Uuid
  workspaceId         String                   @map("workspace_id") @db.Uuid
  label               String?
  codeHash            String                   @unique @map("code_hash")
  status              DesktopBindingCodeStatus @default(PENDING)
  expiresAt           DateTime?                @map("expires_at")
  redeemedAt          DateTime?                @map("redeemed_at")
  redeemedDeviceId    String?                  @map("redeemed_device_id") @db.Uuid
  createdByAccountId  String?                  @map("created_by_account_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  redeemedDevice DesktopDevice? @relation(fields: [redeemedDeviceId], references: [id], onDelete: SetNull)
  createdBy      Account?       @relation(fields: [createdByAccountId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdByAccountId])
  @@index([redeemedDeviceId])
  @@map("desktop_binding_codes")
}

model DesktopDevice {
  id             String              @id @default(uuid()) @db.Uuid
  workspaceId    String              @map("workspace_id") @db.Uuid
  runtimeId      String              @map("runtime_id")
  deviceId       String              @map("device_id")
  deviceName     String              @map("device_name")
  platform       String
  appVersion     String              @map("app_version")
  tokenHash      String              @unique @map("token_hash")
  status         DesktopDeviceStatus @default(ACTIVE)
  boundAt        DateTime            @default(now()) @map("bound_at")
  lastSeenAt     DateTime?           @map("last_seen_at")
  lastSyncedAt   DateTime?           @map("last_synced_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bindingCodes DesktopBindingCode[]
  agreementAcceptances DesktopAgreementAcceptance[]
  issueReports DesktopIssueReport[]
  aiQuota DesktopDeviceAiQuota?
  aiPointLedgerEntries AiPointLedgerEntry[]
  softwareCopilotDeviceBindings SoftwareCopilotDeviceBinding[]

  @@unique([workspaceId, runtimeId])
  @@unique([workspaceId, deviceId])
  @@index([workspaceId])
  @@index([status])
  @@index([lastSeenAt])
  @@map("desktop_devices")
}

model AiPointWallet {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @unique @map("workspace_id") @db.Uuid
  balancePoints  Int      @default(0) @map("balance_points")
  reservedPoints Int      @default(0) @map("reserved_points")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ai_point_wallets")
}

model AiPointCreditBucket {
  id              String                        @id @default(uuid()) @db.Uuid
  workspaceId     String                        @map("workspace_id") @db.Uuid
  sourceType      AiPointCreditBucketSourceType @map("source_type")
  subscriptionId  String?                       @map("subscription_id") @db.Uuid
  billingOrderId  String?                       @map("billing_order_id") @db.Uuid
  totalPoints     Int                           @map("total_points")
  availablePoints Int                           @map("available_points")
  reservedPoints  Int                           @default(0) @map("reserved_points")
  startsAt        DateTime                      @default(now()) @map("starts_at")
  expiresAt       DateTime?                     @map("expires_at")
  status          AiPointCreditBucketStatus     @default(ACTIVE)
  metadata        Json?
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  billingOrder  BillingOrder?  @relation(fields: [billingOrderId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, expiresAt])
  @@index([workspaceId, sourceType])
  @@index([subscriptionId])
  @@index([billingOrderId])
  @@map("ai_point_credit_buckets")
}

model AiPointLedgerEntry {
  id              String                   @id @default(uuid()) @db.Uuid
  workspaceId     String                   @map("workspace_id") @db.Uuid
  desktopDeviceId String?                  @map("desktop_device_id") @db.Uuid
  routeKey        String?                  @map("route_key")
  type            AiPointLedgerEntryType
  status          AiPointLedgerEntryStatus @default(COMPLETED)
  points          Int
  balanceAfter    Int?                     @map("balance_after")
  description     String?
  metadata        Json?
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  desktopDevice DesktopDevice? @relation(fields: [desktopDeviceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([desktopDeviceId, createdAt])
  @@index([routeKey])
  @@index([type, status])
  @@map("ai_point_ledger_entries")
}

model OfficialModelRoute {
  id                 String                       @id @default(uuid()) @db.Uuid
  routeKey           String                       @unique @map("route_key")
  displayName        String                       @map("display_name")
  capability         OfficialModelRouteCapability
  status             OfficialModelRouteStatus     @default(ACTIVE)
  pointPrice         Int                          @default(1) @map("point_price")
  providerId         String                       @map("provider_id")
  providerName       String                       @map("provider_name")
  modelName          String                       @map("model_name")
  apiBaseUrl         String                       @map("api_base_url")
  apiKeyEnvName      String                       @map("api_key_env_name")
  providerConfig     Json                         @default("{}") @map("provider_config")
  sortOrder          Int                          @default(1000) @map("sort_order")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  apiKeys            OfficialModelApiKey[]

  @@index([capability, status, sortOrder])
  @@map("official_model_routes")
}

model OfficialModelApiKey {
  id                 String                    @id @default(uuid()) @db.Uuid
  routeKey           String                    @map("route_key")
  label              String
  providerId         String                    @map("provider_id")
  apiKeySecret       String                    @map("api_key_secret")
  apiKeyLastFour     String                    @map("api_key_last_four")
  status             OfficialModelApiKeyStatus @default(ACTIVE)
  maxConcurrency     Int                       @default(1) @map("max_concurrency")
  currentConcurrency Int                       @default(0) @map("current_concurrency")
  rpmLimit           Int?                      @map("rpm_limit")
  cooldownUntil      DateTime?                 @map("cooldown_until")
  failureCount       Int                       @default(0) @map("failure_count")
  lastUsedAt         DateTime?                 @map("last_used_at")
  lastError          String?                   @map("last_error")
  sortOrder          Int                       @default(1000) @map("sort_order")
  metadata           Json                      @default("{}")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  route              OfficialModelRoute        @relation(fields: [routeKey], references: [routeKey], onDelete: Cascade)
  leases             OfficialModelApiKeyLease[]

  @@index([routeKey, status, sortOrder])
  @@index([providerId, status])
  @@map("official_model_api_keys")
}

model OfficialModelApiKeyLease {
  id          String                         @id @default(uuid()) @db.Uuid
  apiKeyId    String                         @map("api_key_id") @db.Uuid
  routeKey    String                         @map("route_key")
  status      OfficialModelApiKeyLeaseStatus @default(ACTIVE)
  acquiredAt  DateTime                       @default(now()) @map("acquired_at")
  releasedAt  DateTime?                      @map("released_at")
  expiresAt   DateTime                       @map("expires_at")
  requestKind String?                        @map("request_kind")
  providerJobId String?                      @map("provider_job_id")
  metadata    Json                           @default("{}")

  apiKey      OfficialModelApiKey            @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, status, acquiredAt])
  @@index([routeKey, status, acquiredAt])
  @@index([routeKey, providerJobId, status])
  @@index([expiresAt, status])
  @@map("official_model_api_key_leases")
}

model DesktopDeviceAiQuota {
  id                  String                     @id @default(uuid()) @db.Uuid
  workspaceId          String                     @map("workspace_id") @db.Uuid
  desktopDeviceId      String                     @unique @map("desktop_device_id") @db.Uuid
  monthlyLimitPoints   Int?                       @map("monthly_limit_points")
  usedPointsThisMonth  Int                        @default(0) @map("used_points_this_month")
  reservedPoints       Int                        @default(0) @map("reserved_points")
  period               String
  status               DesktopDeviceAiQuotaStatus @default(ACTIVE)
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  desktopDevice DesktopDevice @relation(fields: [desktopDeviceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, period])
  @@index([status])
  @@map("desktop_device_ai_quotas")
}

model DesktopAgreementAcceptance {
  id                 String   @id @default(uuid()) @db.Uuid
  agreementKey       String   @map("agreement_key")
  agreementVersion   String   @map("agreement_version")
  contentHash        String   @map("content_hash")
  runtimeId          String   @map("runtime_id")
  deviceId           String   @map("device_id")
  deviceName         String?  @map("device_name")
  platform           String?
  appVersion         String?  @map("app_version")
  workspaceId        String?  @map("workspace_id")
  desktopDeviceId    String?  @map("desktop_device_id") @db.Uuid
  consentMethod      String   @map("consent_method")
  minimumReadSeconds Int?     @map("minimum_read_seconds")
  actualReadSeconds  Int?     @map("actual_read_seconds")
  ipAddress          String?  @map("ip_address")
  userAgent          String?  @map("user_agent")
  acceptedAt         DateTime @default(now()) @map("accepted_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  desktopDevice DesktopDevice? @relation(fields: [desktopDeviceId], references: [id], onDelete: SetNull)

  @@unique([agreementKey, agreementVersion, contentHash, runtimeId])
  @@index([agreementKey, agreementVersion, contentHash])
  @@index([runtimeId, deviceId])
  @@index([workspaceId])
  @@index([desktopDeviceId])
  @@index([acceptedAt])
  @@map("desktop_agreement_acceptances")
}

model Plan {
  id           String       @id @default(uuid()) @db.Uuid
  code         PlanCode     @unique
  name         String
  description  String?
  billingCycle BillingCycle @map("billing_cycle")
  priceCents   Int?         @map("price_cents")
  currency     String?
  status       PlanStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  entitlements  Entitlement[]
  subscriptions Subscription[]
  billingOrders BillingOrder[]

  @@map("plans")
}

model Entitlement {
  id         String   @id @default(uuid()) @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(true)
  limitValue Int?     @map("limit_value")
  limitUnit  String?  @map("limit_unit")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("entitlements")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  workspaceId        String             @map("workspace_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  billingCycle       BillingCycle       @map("billing_cycle")
  currentPeriodStart DateTime?          @map("current_period_start")
